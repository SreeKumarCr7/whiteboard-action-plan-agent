# AWS credentials for Textract OCR.
# Create a scoped-down IAM user (see README) and set these before running.
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1

# Groq API key for note cleanup and action-item extraction.
# Get one at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key

# Optional: override the default model (openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b

# Tavily API key for researching unclear terms.
# Get one at https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key
