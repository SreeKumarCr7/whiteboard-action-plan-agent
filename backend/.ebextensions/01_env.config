# Elastic Beanstalk environment variables are set via `eb setenv` (or the
# console) — NOT committed here. This file intentionally contains no
# credentials. Set at deploy time:
#   eb setenv AWS_ACCESS_KEY_ID=... AWS_SECRET_ACCESS_KEY=... AWS_REGION=...
#             GROQ_API_KEY=... TAVILY_API_KEY=... ALLOWED_ORIGINS=...
